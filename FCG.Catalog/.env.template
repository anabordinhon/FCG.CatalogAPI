# FCG Catalog API Docker Environment Variables
# Copy this file to .env and customize as needed

# SQL Server Configuration
SA_PASSWORD=SUBSTITUIR_COM_SENHA_FORTE
MSSQL_PID=Developer
CONNECTION_STRING=SUA_CONNECTION_STRING_AQUI

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=SUBSTITUIR_COM_USUARIO
RABBITMQ_DEFAULT_PASS=SUBSTITUIR_COM_SENHA
RABBITMQ_HOST=rabbitmq

# JWT Configuration
JWT_SECRET_KEY=SUBSTITUIR_COM_CHAVE_MINIMO_32_CARACTERES

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Port Configuration (if you need to change default ports)
# SQL_SERVER_PORT=1433
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# API_PORT=8080
